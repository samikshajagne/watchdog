# --- Supabase ---
# Project Settings -> API in your Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Project Settings -> API -> service_role key. Server-side only, never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
# The public URL this app is deployed at (used for auth redirects and Stripe redirect URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Stripe ---
STRIPE_SECRET_KEY=
# Dashboard -> Developers -> Webhooks -> your endpoint -> Signing secret
STRIPE_WEBHOOK_SECRET=
# Create these as recurring Prices in Stripe and paste their price IDs here
STRIPE_PRICE_STARTER=
STRIPE_PRICE_AGENCY=
STRIPE_PRICE_SCALE=

# --- Resend (email alerts) ---
RESEND_API_KEY=
# Must be a domain or address verified in your Resend account
ALERT_FROM_EMAIL=alerts@yourdomain.com

# --- Cron ---
# Any random string. Set the same value in Vercel's cron header config so only Vercel can trigger checks.
CRON_SECRET=
