# --- Supabase ---
# Project Settings -> API in your Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Project Settings -> API -> service_role key. Server-side only, never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
# The public URL this app is deployed at (used for auth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Razorpay (billing) ---
# Dashboard -> Account & Settings -> API Keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard -> Account & Settings -> Webhooks -> your endpoint -> Secret
RAZORPAY_WEBHOOK_SECRET=
# Create these as Plans in Razorpay (Dashboard -> Subscriptions -> Plans) and paste their plan IDs here
RAZORPAY_PLAN_STARTER=
RAZORPAY_PLAN_AGENCY=
RAZORPAY_PLAN_SCALE=

# --- Resend (email alerts) ---
RESEND_API_KEY=
# Must be a domain or address verified in your Resend account
ALERT_FROM_EMAIL=alerts@yourdomain.com

# --- Cron ---
# Any random string. Set the same value in Vercel's cron header config so only Vercel can trigger checks.
CRON_SECRET=
